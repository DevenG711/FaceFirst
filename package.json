{
  "name": "sentra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Escalate-only stroke-warning prototype. Not a medical device.",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest --run",
    "lint:safety": "node scripts/safety-lint.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "idb-keyval": "6.3.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
